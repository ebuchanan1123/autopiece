NODE_ENV=development
PORT=3002

# Database
DATABASE_URL=postgres://tgtg:tgtg-password@localhost:5433/tgtg_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Auth
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_FINGERPRINT_SECRET=replace_with_a_different_64_character_random_secret
SESSION_FINGERPRINT_STRICT=false

# Cookies / CORS
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19006

# Translation / maps
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Payments
PAYMENTS_PROVIDER=mock
SATIM_MODE=test
SATIM_MERCHANT_ID=
SATIM_TERMINAL_ID=
SATIM_API_KEY=
SATIM_CALLBACK_SECRET=
SATIM_RETURN_URL=http://localhost:3002/payments/satim/return
SATIM_CALLBACK_URL=http://localhost:3002/payments/satim/callback
